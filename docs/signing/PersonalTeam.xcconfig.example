XDRIP_ENTITLEMENTS_DEBUG = xDripPersonalTeam.entitlements
XDRIP_ENTITLEMENTS_RELEASE = xDripPersonalTeam.entitlements
OTTAI_NFC_WAKE_ENABLED = NO
